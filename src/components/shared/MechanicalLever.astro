---
/**
 * MechanicalLever.astro  (refactored — lever removed, switch button only)
 * Fixed bottom-center red switch button with pulsing/blinking indicator light.
 *
 * Interaction model (design.md §5):
 *   - Click on the button → fires 'lever:pull' custom event (handled by lever.ts)
 *   - Keyboard: Enter/Space on the element also fires the event (a11y)
 *   - The blinking red light draws attention and signals the current view state
 */
---

<!-- Fixed bottom-center switch button -->
<div
  id="mechanical-lever"
  class="switch-assembly"
  role="button"
  tabindex="0"
  aria-label="Toggle view: Executive ↔ GameDev"
  aria-pressed="false"
>
  <!-- Pulsing indicator light -->
  <div class="switch-light" aria-hidden="true">
    <div class="switch-light-inner"></div>
  </div>

  <!-- Button body -->
  <div class="switch-btn" aria-hidden="true">
    <!-- Radial highlight for 3-D depth -->
    <div class="switch-btn-highlight"></div>
  </div>

  <!-- View-state label -->
  <div class="switch-label" aria-live="polite">
    <span data-lever-label="executive">Executive View</span>
    <span data-lever-label="gamedev">HUD Mode</span>
  </div>
</div>


<style>
  /* ----------------------------------------------------------------
     Switch Assembly — fixed bottom-center (z-50)
     ---------------------------------------------------------------- */
  .switch-assembly {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    translate: -50% 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    user-select: none;
  }

  .switch-assembly:focus-visible {
    outline: 2px solid var(--cp-cyan, #00f0ff);
    outline-offset: 8px;
    border-radius: 50%;
  }

  /* ----------------------------------------------------------------
     Indicator light (blinking ring above the button)
     ---------------------------------------------------------------- */
  .switch-light {
    width: 14px;
    height: 14px;
    border-radius: 9999px;
    background: rgba(255, 0, 48, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: pulse-ring 1.6s ease-in-out infinite;
  }

  .switch-light-inner {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: #ff0030;
    box-shadow:
      0 0 6px 2px rgba(255, 0, 48, 0.9),
      0 0 12px 4px rgba(255, 0, 48, 0.5);
    animation: blink-dot 1.6s ease-in-out infinite;
  }

  /* When GameDev is active → switch to cyan light */
  :global(body[data-view="gamedev"]) .switch-light {
    background: rgba(0, 240, 255, 0.15);
    animation: pulse-ring-cyan 1.6s ease-in-out infinite;
  }
  :global(body[data-view="gamedev"]) .switch-light-inner {
    background: #00f0ff;
    box-shadow:
      0 0 6px 2px rgba(0, 240, 255, 0.9),
      0 0 12px 4px rgba(0, 240, 255, 0.5);
    animation: blink-dot-cyan 1.6s ease-in-out infinite;
  }

  /* ----------------------------------------------------------------
     Switch button body — large red circular button
     ---------------------------------------------------------------- */
  .switch-btn {
    width: 64px;
    height: 64px;
    border-radius: 9999px;
    position: relative;
    /* Deep red radial gradient for 3-D dome look */
    background: radial-gradient(
      circle at 35% 30%,
      #ff4466 0%,
      #cc0022 45%,
      #880011 100%
    );
    box-shadow:
      0 0 18px 6px rgba(255, 0, 48, 0.55),
      0 6px 18px rgba(0, 0, 0, 0.75),
      inset 0 -4px 8px rgba(0, 0, 0, 0.5),
      inset 0 4px 8px rgba(255, 120, 120, 0.25);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
    will-change: transform, box-shadow;
  }

  /* Hover: lift + stronger glow */
  .switch-assembly:hover .switch-btn,
  .switch-assembly:focus-visible .switch-btn {
    transform: scale(1.07) translateY(-2px);
    box-shadow:
      0 0 30px 10px rgba(255, 0, 48, 0.75),
      0 8px 24px rgba(0, 0, 0, 0.85),
      inset 0 -4px 8px rgba(0, 0, 0, 0.5),
      inset 0 4px 10px rgba(255, 140, 140, 0.35);
  }

  /* Active/pressed: push down */
  .switch-assembly:active .switch-btn {
    transform: scale(0.96) translateY(2px);
    box-shadow:
      0 0 12px 4px rgba(255, 0, 48, 0.5),
      0 2px 8px rgba(0, 0, 0, 0.8),
      inset 0 4px 10px rgba(0, 0, 0, 0.6);
  }

  /* Specular highlight — white arc for 3-D dome illusion */
  .switch-btn-highlight {
    position: absolute;
    top: 14%;
    left: 18%;
    width: 40%;
    height: 30%;
    border-radius: 9999px;
    background: radial-gradient(
      ellipse at center,
      rgba(255, 255, 255, 0.55) 0%,
      transparent 75%
    );
    pointer-events: none;
    transform: rotate(-20deg);
  }

  /* ----------------------------------------------------------------
     View-state label below the button
     ---------------------------------------------------------------- */
  .switch-label {
    font-family: var(--font-jetbrains, monospace);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    color: var(--cp-cyan, #00f0ff);
    opacity: 0.75;
    height: 14px;
    overflow: hidden;
  }

  [data-lever-label="gamedev"] {
    display: none;
    color: var(--cp-red, #ff003c);
  }

  :global(body[data-view="gamedev"]) [data-lever-label="executive"] {
    display: none;
  }

  :global(body[data-view="gamedev"]) [data-lever-label="gamedev"] {
    display: inline;
  }

  /* ----------------------------------------------------------------
     Keyframe animations
     ---------------------------------------------------------------- */

  /* Red outer ring pulse */
  @keyframes pulse-ring {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 0, 48, 0.5); opacity: 1; }
    50%       { box-shadow: 0 0 0 6px rgba(255, 0, 48, 0); opacity: 0.6; }
  }

  /* Red inner dot blink */
  @keyframes blink-dot {
    0%, 100% { opacity: 1;   box-shadow: 0 0 6px 2px rgba(255,0,48,0.9), 0 0 14px 5px rgba(255,0,48,0.5); }
    45%      { opacity: 0.15; box-shadow: none; }
    55%      { opacity: 0.15; box-shadow: none; }
  }

  /* Cyan outer ring pulse (GameDev active) */
  @keyframes pulse-ring-cyan {
    0%, 100% { box-shadow: 0 0 0 0 rgba(0, 240, 255, 0.5); opacity: 1; }
    50%       { box-shadow: 0 0 0 6px rgba(0, 240, 255, 0); opacity: 0.6; }
  }

  /* Cyan inner dot blink (GameDev active) */
  @keyframes blink-dot-cyan {
    0%, 100% { opacity: 1;   box-shadow: 0 0 6px 2px rgba(0,240,255,0.9), 0 0 14px 5px rgba(0,240,255,0.5); }
    45%      { opacity: 0.15; box-shadow: none; }
    55%      { opacity: 0.15; box-shadow: none; }
  }

  /* ----------------------------------------------------------------
     Prefers-reduced-motion: disable all animations
     ---------------------------------------------------------------- */
  @media (prefers-reduced-motion: reduce) {
    .switch-light,
    .switch-light-inner {
      animation: none;
    }
    .switch-assembly {
      transition: none;
    }
  }
</style>

