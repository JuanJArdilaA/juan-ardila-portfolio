---
import { Mail, Repeat, Terminal } from '@lucide/astro';
import { profile } from '../../data/portfolioData';
import { t } from '../../scripts/i18n';

/** Section links resolved at click time against the active face (see ui.ts). */
const links = [
  { target: 'projects', key: 'nav.projects' },
  { target: 'education', key: 'nav.education' },
  { target: 'skills', key: 'nav.skills' },
  { target: 'contact', key: 'nav.contact' },
] as const;
---

<header
  id="site-navbar"
  class="fixed inset-x-0 top-0 z-40 border-b border-panel-border/80 bg-obsidian/80 backdrop-blur-xl"
>
  <nav
    class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-2 px-3 sm:gap-4 sm:px-6"
    aria-label={t('nav.main.aria')}
    data-i18n-aria-label="nav.main.aria"
  >
    <a href="#main-content" class="flex min-w-0 items-center gap-2.5" id="nav-brand">
      <span class="brand-mark hidden sm:grid" aria-hidden="true">
        <Terminal size={16} stroke-width={2.4} />
      </span>
      <span class="max-w-[6.5rem] text-[0.8125rem] font-semibold leading-tight tracking-tight text-gray-100 min-[400px]:max-w-none sm:text-sm">
        {profile.fullName}
      </span>
    </a>

    <ul class="hidden items-center gap-6 lg:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={`#executive-${link.target}`}
              class="nav-link"
              data-nav-target={link.target}
              data-i18n-key={link.key}
            >
              {t(link.key)}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2.5">
      <span class="core-indicator hidden xl:inline-flex" aria-live="polite">
        <span class="core-dot" aria-hidden="true"></span>
        <span data-core-label="executive" data-i18n-key="nav.core.executive">{t('nav.core.executive')}</span>
        <span data-core-label="gamedev" data-i18n-key="nav.core.gamedev">{t('nav.core.gamedev')}</span>
      </span>

      <div
        class="lang-toggle"
        role="group"
        aria-label={t('nav.lang.aria')}
        data-i18n-aria-label="nav.lang.aria"
      >
        <button type="button" id="lang-en" data-lang-option="en" aria-pressed="true">EN</button>
        <button type="button" id="lang-es" data-lang-option="es" aria-pressed="false">ES</button>
      </div>

      <button
        type="button"
        id="nav-copy-email"
        class="nav-btn"
        data-action="copy-email"
        aria-label={t('nav.copyEmail')}
        data-i18n-aria-label="nav.copyEmail"
      >
        <Mail size={16} />
        <span class="hidden font-mono text-xs 2xl:inline">{profile.email}</span>
      </button>

      <button
        type="button"
        id="nav-switch-view"
        class="nav-btn"
        data-action="toggle-view"
        aria-label={t('nav.switch.aria')}
        data-i18n-aria-label="nav.switch.aria"
      >
        <Repeat size={16} />
        <span class="hidden xl:inline" data-i18n-key="nav.switch">{t('nav.switch')}</span>
        <kbd class="kbd hidden md:inline">Alt+S</kbd>
      </button>
    </div>
  </nav>
</header>
