---
import SyncBadge from '../shared/SyncBadge.astro';
import { renderQuestCards } from '../../scripts/projectCards';
import { t } from '../../scripts/i18n';
import { getManifestProjects } from '../../services/githubService';

/** SSR first paint from the local manifest; the client re-renders after the GitHub sync. */
const initialCards = renderQuestCards(getManifestProjects());
---

<section id="gamedev-projects" class="hud-section scroll-mt-24" aria-labelledby="quest-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <p class="hud-eyebrow">// 01</p>
        <h2 id="quest-title" class="hud-section-title" data-i18n-key="hud.questlog">{t('hud.questlog')}</h2>
        <p class="mt-3 text-gray-400" data-i18n-key="hud.questlog.sub">{t('hud.questlog.sub')}</p>
      </div>
      <SyncBadge />
    </div>

    <div id="gamedev-projects-grid" class="quest-grid" set:html={initialCards} />
  </div>
</section>
