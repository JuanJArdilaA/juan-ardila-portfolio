---
import { education, skillGroups } from '../../data/portfolioData';
import { t } from '../../scripts/i18n';
---

<section id="executive-education" class="exec-section scroll-mt-24" aria-labelledby="education-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <p class="section-eyebrow" data-i18n-key="section.education.eyebrow">{t('section.education.eyebrow')}</p>
    <h2 id="education-title" class="section-title" data-i18n-key="section.education">{t('section.education')}</h2>

    <ol class="timeline mt-10">
      {
        education.map((item) => (
          <li class="timeline-item" id={`edu-${item.id}`}>
            <article class="bento-card">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <h3 class="bento-card__title">{item.institution}</h3>
                  <p class="mt-1 text-gray-300" data-l10n-en={item.degree.en} data-l10n-es={item.degree.es}>
                    {item.degree.en}
                  </p>
                </div>
                <span class="period-badge" data-l10n-en={item.period.en} data-l10n-es={item.period.es}>
                  {item.period.en}
                </span>
              </div>
              <p class="bento-card__desc bento-card__desc--full" data-l10n-en={item.focus.en} data-l10n-es={item.focus.es}>
                {item.focus.en}
              </p>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section id="executive-skills" class="exec-section scroll-mt-24" aria-labelledby="skills-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <p class="section-eyebrow" data-i18n-key="section.skills.eyebrow">{t('section.skills.eyebrow')}</p>
    <h2 id="skills-title" class="section-title" data-i18n-key="section.skills">{t('section.skills')}</h2>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        skillGroups.map((group) => (
          <article class="bento-card" id={`skills-${group.id}`}>
            <h3 class="skill-group__title" data-l10n-en={group.title.en} data-l10n-es={group.title.es}>
              {group.title.en}
            </h3>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((skill) => (
                <li class="skill-chip" data-l10n-en={skill.label.en} data-l10n-es={skill.label.es}>
                  {skill.label.en}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
