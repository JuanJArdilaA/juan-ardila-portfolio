---
import ExecutiveHero from './ExecutiveHero.astro';
import BentoProjects from './BentoProjects.astro';
import EducationAndSkills from './EducationAndSkills.astro';
import ContactPanel from '../shared/ContactPanel.astro';
import { profile } from '../../data/portfolioData';
import { t } from '../../scripts/i18n';

const year = new Date().getFullYear();
---

<div id="executive-view" class="exec-root">
  <ExecutiveHero />
  <BentoProjects />
  <EducationAndSkills />

  <div class="exec-section">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <ContactPanel variant="executive" />
    </div>
  </div>

  <footer class="exec-footer">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2 px-4 sm:px-6">
      <p>© {year} {profile.fullName}</p>
      <p data-i18n-key="footer.built">{t('footer.built')}</p>
    </div>
  </footer>
</div>
