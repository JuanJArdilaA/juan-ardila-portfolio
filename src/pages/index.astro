---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/shared/Navbar.astro';
import ToastNotification from '../components/shared/ToastNotification.astro';
import ProjectModal from '../components/shared/ProjectModal.astro';

import ExecutiveView from '../components/executive/ExecutiveView.astro';
import GameDevView from '../components/gamedev/GameDevView.astro';
import { t } from '../scripts/i18n';
---

<MainLayout>
  <a href="#main-content" class="skip-link" data-i18n-key="a11y.skip">{t('a11y.skip')}</a>

  <Navbar />

  <main id="main-content">
    <!--
      3D Stage (design.md §4):
        #viewport-stage  — perspective container (global.css: perspective 1600px)
        #roulette-drum   — transform-style: preserve-3d wrapper (no own transform)
        .drum-face       — each face: backface-visibility hidden, CSS transitions driven by body[data-view]

      Rotation vectors (global.css §100-177):
        Executive → GameDev: exec tilts to rotateX(90deg)+translateY(-100%), gamedev comes in from rotateX(-90deg)+translateY(100%) → 0
        GameDev → Executive: reverse vectors
    -->
    <div id="viewport-stage">
      <div id="roulette-drum">

        <!-- FACE A: Executive View (default / IDLE_EXECUTIVE state) -->
        <div id="executive-face" class="drum-face">
          <ExecutiveView />
        </div>

        <!--
          FACE B: GameDev / Cyberpunk 2077 HUD View
          Initially inert: keyboard focus & screen-reader invisible until activated by setActiveView()
        -->
        <div id="gamedev-face" class="drum-face" inert aria-hidden="true">
          <GameDevView />
        </div>

      </div>
    </div>
  </main>



  <ToastNotification />
  <ProjectModal />

  <script>
    import '../scripts/main';
  </script>
</MainLayout>
